{
  "package": "com.deepseekband.app",
  "name": "DeepSeekB",
  "versionName": "1.0.0",
  "versionCode": 1,
  "minPlatformVersion": 1000,
  "icon": "/common/logo.png",
  "deviceTypeList": [
    "watch"
  ],
  "features": [
    { "name": "system.interconnect" },
    { "name": "system.file" },
    { "name": "system.vibrator" },
    { "name": "system.device" },
    { "name": "system.app" },
    { "name": "system.router" },
    { "name": "system.prompt" },
    { "name": "system.brightness" },
    { "name": "system.storage" },
    { "name": "system.fetch" }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 192
  },
  "router": {
    "entry": "pages/index",
    "pages": {
      "pages/index": {
        "component": "index"
      },
      "pages/detail": {
        "component": "detail"
      },
      "pages/settings": {
        "component": "settings"
      },
      "pages/chat": {
        "component": "chat"
      }
    }
  },
  "permissions": [
    {
      "name": "hapjs.permission.DEVICE_INFO"
    }
  ],
  "minAPILevel": 1
}

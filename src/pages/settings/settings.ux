<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <text class="clock">{{ clock }}</text>
    <text class="title">Настройки</text>

    <list class="list">
      <list-item class="entry" type="item" for="{{ items }}">
        <text if="{{ $item.kind === 'section' }}" class="section">{{ $item.label }}</text>
        <div if="{{ $item.kind === 'row' }}" class="item" onclick="onItemClick($idx)">
          <div class="card">
            <div class="card-main">
              <text class="card-label">{{ $item.label }}</text>
              <text if="{{ $item.value }}" class="card-value">{{ $item.value }}</text>
            </div>
            <div
              if="{{ $item.id === 'auto' }}"
              class="switch {{ autoDelete ? 'switch-on' : 'switch-off' }}">
              <div class="switch-knob"></div>
            </div>
          </div>
        </div>
      </list-item>
      <list-item class="item-pad" type="pad"></list-item>
    </list>

    <div if="{{ clearShow }}" class="mask">
      <div class="dialog">
        <div class="dialog-btn dialog-btn-cancel" onclick="cancelClear">
          <image class="dialog-btn-icon" src="/common/images/arrow.png"></image>
        </div>
        <text class="dialog-title">Удалить все диалоги?</text>
        <text class="dialog-sub">Вся история сообщений будет стёрта</text>
        <div class="dialog-btn dialog-btn-delete" onclick="confirmClear">
          <image class="dialog-btn-icon dialog-btn-icon-delete" src="/common/images/trash.png"></image>
        </div>
      </div>
    </div>

    <div if="{{ diagShow }}" class="mask">
      <div class="diag-dialog">
        <scroll class="diag-scroll" scroll-y="true">
          <text class="diag-title">Проверка API</text>
          <text class="diag-text">{{ diagText }}</text>
        </scroll>
        <div class="diag-btn" onclick="closeDiag">
          <text class="diag-btn-text">Закрыть</text>
        </div>
      </div>
    </div>

    <input-method
      if="{{ keyboardVisible }}"
      id="im"
      keyboard-type="{{ keyboardType }}"
      initial-text="{{ keyDraft }}"
      @input="onKeyInput"
      @delete="onKeyDelete"
      @enter="onKeyEnter"
      @hide="onKeyboardHide">
    </input-method>
  </div>
</template>

<script>
import {
  KEY_API_KEY,
  KEY_AUTO_DELETE,
  KEY_KEYBOARD_MODE,
  KEY_MODEL,
  KEY_NETWORK_MODE,
  KEY_THINKING_MODE,
  AUTO_DELETE_DAYS,
  getValue,
  setValue,
  removeValue,
  cleanupInactiveChats,
  clearAllChats
} from "../../common/app-store.js"
import { NETWORK_MODES, apiDiagnose, DEFAULT_MODEL, REASONER_MODEL } from "../../common/deepseek-api.js"
import { bridgeSupported, bridgeDiagnose, bridgePing, bridgeReady } from "../../common/bridge.js"

export default {
  private: {
    clock: "",
    items: [],
    apiKey: "",
    autoDelete: false,
    clearShow: false,
    diagShow: false,
    diagText: "",
    keyboardVisible: false,
    keyboardType: "QWERTY",
    keyDraft: "",
    timer: null,
    networkMode: "auto",
    bridgeStatus: "не проверен",
    thinkingMode: "off"
  },

  onInit() {
    this.tick()
    this.timer = setInterval(() => {
      this.tick()
    }, 20000)
    this.refreshItems()
    this.loadSettings()
  },

  onShow() {
    this.tick()
    this.loadSettings()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const now = new Date()
    const h = now.getHours()
    const m = now.getMinutes()
    this.clock = (h < 10 ? "0" + h : "" + h) + ":" + (m < 10 ? "0" + m : "" + m)
  },

  loadSettings() {
    getValue(KEY_API_KEY, "", (value) => {
      this.apiKey = value || ""
      this.refreshItems()
    })
    getValue(KEY_AUTO_DELETE, "off", (value) => {
      this.autoDelete = value === "on"
      this.refreshItems()
    })
    getValue(KEY_NETWORK_MODE, "auto", (value) => {
      this.networkMode = value || "auto"
      this.refreshBridge()
      this.refreshItems()
    })
    getValue(KEY_THINKING_MODE, "off", (value) => {
      this.thinkingMode = value || "off"
      this.refreshItems()
    })
  },

  refreshItems() {
    let apiValue = "Не задан"
    if (this.apiKey) {
      apiValue = this.apiKey.length > 8 ? "…" + this.apiKey.slice(-4) : "Задан"
    }
    const net = this.networkMode || "auto"
    let netLabel = "Авто"
    for (let i = 0; i < NETWORK_MODES.length; i++) {
      const m = NETWORK_MODES.slice(i, i + 1).pop()
      if (m && m.id === net) {
        netLabel = m.title
        break
      }
    }
    this.items = [
      { kind: "section", label: "API" },
      { kind: "row", id: "api", label: "API-ключ", value: apiValue },
      { kind: "row", id: "check", label: "Проверить API", value: "Нажмите" },
      { kind: "row", id: "thinking", label: "Думающий R1", value: this.thinkingMode === "on" ? "Вкл" : "Выкл" },
      { kind: "section", label: "Сеть" },
      { kind: "row", id: "net", label: "Режим сети", value: netLabel },
      { kind: "row", id: "bridge", label: "Мост FetchBridge", value: this.bridgeStatus },
      { kind: "section", label: "Чаты" },
      { kind: "row", id: "auto", label: "Автоудаление", value: this.autoDelete ? "3 дня" : "Выкл" },
      { kind: "row", id: "clear", label: "Очистить чаты", value: "Удалить" }
    ]
  },

  onItemClick($idx) {
    const item = this.items.slice($idx, $idx + 1).pop()
    if (!item || item.kind !== "row") {
      return
    }
    if (item.id === "api") {
      this.openApiKey()
    } else if (item.id === "check") {
      this.checkApi()
    } else if (item.id === "thinking") {
      this.cycleThinking()
    } else if (item.id === "net") {
      this.cycleNetwork()
    } else if (item.id === "bridge") {
      this.checkBridge()
    } else if (item.id === "auto") {
      this.toggleAutoDelete()
    } else if (item.id === "clear") {
      this.clearShow = true
    }
  },

  cycleThinking() {
    this.thinkingMode = this.thinkingMode === "on" ? "off" : "on"
    setValue(KEY_THINKING_MODE, this.thinkingMode)
    setValue(KEY_MODEL, this.thinkingMode === "on" ? REASONER_MODEL : DEFAULT_MODEL)
    this.refreshItems()
  },

  cycleNetwork() {
    const order = ["auto", "bridge", "direct", "doh", "relay"]
    let cur = order.indexOf(this.networkMode)
    if (cur < 0) cur = 0
    const nextIndex = (cur + 1) % order.length
    this.networkMode = order.slice(nextIndex, nextIndex + 1).pop()
    setValue(KEY_NETWORK_MODE, this.networkMode)
    this.refreshBridge()
    this.refreshItems()
  },

  checkApi() {
    if (!this.apiKey) {
      this.diagText = "Сначала задайте API-ключ в пункте выше"
      this.diagShow = true
      return
    }
    this.diagText = "Проверяю..."
    this.diagShow = true
    const self = this
    apiDiagnose({
      apiKey: this.apiKey,
      timeout: 15000
    })
      .then(function (res) {
        let text = res.ok ? (res.text || "Ключ работает") : (res.text || "Ошибка")
        text = text + "\n\nHTTP " + (res.status || "-")
        if (res.hint) {
          text = text + "\n\n" + res.hint
        }
        self.diagText = text
      })
      .catch(function (err) {
        self.diagText = "Ошибка: " + ((err && err.message) || "неизвестно")
      })
  },

  closeDiag() {
    this.diagShow = false
  },

  refreshBridge() {
    if (!bridgeSupported()) {
      this.bridgeStatus = "не поддерживается"
      return
    }
    let ready = false
    try {
      ready = bridgeReady()
    } catch (e) {}
    this.bridgeStatus = ready ? "готов к работе" : "не проверен"
  },

  checkBridge() {
    if (!bridgeSupported()) {
      this.bridgeStatus = "не поддерживается"
      this.refreshItems()
      return
    }
    this.bridgeStatus = "поиск..."
    this.refreshItems()
    try {
      bridgePing()
    } catch (e) {}
    const self = this
    setTimeout(function () {
      try {
        if (bridgeReady()) {
          self.bridgeStatus = "готов к работе"
          self.refreshItems()
          return
        }
      } catch (e) {}
      bridgeDiagnose(8000)
        .then(function (res) {
          if (res && (res.status === 0 || res.status === 200 || res.status === 201)) {
            self.bridgeStatus = "готов к работе"
          } else if (res && res.status === 1001) {
            self.bridgeStatus = "включите FetchBridge"
          } else {
            self.bridgeStatus = "нет соединения"
          }
          self.refreshItems()
        })
        .catch(function () {
          self.bridgeStatus = "ошибка"
          self.refreshItems()
        })
    }, 700)
  },

  openApiKey() {
    this.keyDraft = this.apiKey
    this.keyboardVisible = true
  },

  onKeyInput(e) {
    const val = e && e.detail ? e.detail.value : (e && e.value ? e.value : "")
    if (val) {
      this.keyDraft = this.keyDraft + val
    }
  },

  onKeyDelete() {
    if (this.keyDraft.length > 0) {
      this.keyDraft = this.keyDraft.substring(0, this.keyDraft.length - 1)
    }
  },

  onKeyboardHide() {
    this.keyboardVisible = false
    this.keyDraft = ""
  },

  onKeyEnter(e) {
    let raw = this.keyDraft
    if (e && e.detail && typeof e.detail.value === "string") {
      raw = e.detail.value
    } else if (e && typeof e.value === "string") {
      raw = e.value
    }
    const key = raw.trim()
    this.keyboardVisible = false
    this.keyDraft = ""

    if (!key) {
      removeValue(KEY_API_KEY, () => {
        this.apiKey = ""
        this.refreshItems()
      })
      return
    }

    setValue(KEY_API_KEY, key, (ok) => {
      if (ok) {
        this.apiKey = key
      }
      this.refreshItems()
    })
  },

  toggleAutoDelete() {
    const next = !this.autoDelete
    this.autoDelete = next
    setValue(KEY_AUTO_DELETE, next ? "on" : "off")
    this.refreshItems()
    if (next) {
      cleanupInactiveChats(function () {}, AUTO_DELETE_DAYS)
    }
  },

  cancelClear() {
    this.clearShow = false
  },

  confirmClear() {
    this.clearShow = false
    clearAllChats(() => {this.refreshItems()
})
}
}
.page {
width: 192px;
height: 490px;
background-color: #000000;
flex-direction: column;
align-items: center;
}
.clock {
position: absolute;
left: 0px;
top: 26px;
width: 192px;
text-align: center;
font-size: 17px;
font-weight: bold;
line-height: 24px;
color: rgba(255, 255, 255, 0.78);
}
.title {
position: absolute;
left: 0px;
top: 50px;
width: 192px;
text-align: center;
font-size: 22px;
font-weight: bold;
line-height: 28px;
color: #ffffff;
}
.list {
position: absolute;
left: 0px;
top: 88px;
width: 192px;
height: 392px;
}
.entry {
width: 192px;
flex-direction: column;
}
.section {
width: 192px;
height: 28px;
padding-left: 20px;
font-size: 13px;
font-weight: bold;
line-height: 28px;
color: rgba(255, 255, 255, 0.45);
}
.item {
width: 192px;
height: 80px;
justify-content: center;
}
.item-pad {
width: 192px;
height: 20px;
}
.card {
width: 168px;
height: 70px;
margin-left: 12px;
padding-left: 14px;
padding-right: 12px;
background-color: #262626;
border-radius: 20px;
flex-direction: row;
align-items: center;
justify-content: space-between;
}
.card-main {
flex: 1;
flex-direction: column;
justify-content: center;
}
.card-label {
font-size: 15px;
font-weight: bold;
color: #ffffff;
}
.card-value {
margin-top: 3px;
font-size: 13px;
font-weight: bold;
color: #4d6bfe;
}
.switch {
width: 48px;
height: 28px;
border-radius: 14px;
padding-left: 3px;
padding-right: 3px;
align-items: center;
}
.switch-on {
background-color: #4d6bfe;
justify-content: flex-end;
}
.switch-off {
background-color: #3a3a3a;
justify-content: flex-start;
}
.switch-knob {
width: 22px;
height: 22px;
border-radius: 11px;
background-color: #ffffff;
}
.mask {
position: absolute;
left: 0px;
top: 0px;
width: 192px;
height: 490px;
background-color: rgba(0, 0, 0, 0.85);
align-items: center;
justify-content: center;
}
.dialog {
width: 168px;
padding: 16px 12px;
background-color: #262626;
border-radius: 22px;
flex-direction: column;
align-items: center;
}
.dialog-title {
margin-top: 10px;
text-align: center;
font-size: 17px;
font-weight: bold;
color: #ffffff;
}
.dialog-sub {
margin-top: 6px;
text-align: center;
font-size: 13px;
color: rgba(255, 255, 255, 0.6);
}
.dialog-btn {
width: 48px;
height: 48px;
border-radius: 24px;
border-width: 2px;
border-style: solid;
align-items: center;
justify-content: center;
}
.dialog-btn-cancel {
border-color: #4d6bfe;
}
.dialog-btn-delete {
margin-top: 14px;
border-color: #ff5050;
}
.dialog-btn-icon {
width: 28px;
height: 28px;
}
.dialog-btn-icon-delete {
width: 32px;
height: 32px;
}
.diag-dialog {
width: 176px;
height: 290px;
background-color: #262626;
border-radius: 20px;
flex-direction: column;
align-items: center;
padding: 12px;
}
.diag-scroll {
width: 152px;
height: 210px;
}
.diag-title {
text-align: center;
font-size: 17px;
font-weight: bold;
color: #ffffff;
}
.diag-text {
margin-top: 8px;
font-size: 13px;
color: #ffffff;
}
.diag-btn {
width: 110px;
height: 40px;
margin-top: 8px;
border-radius: 20px;
border-width: 2px;
border-style: solid;
border-color: #4d6bfe;
align-items: center;
justify-content: center;
}
.diag-btn-text {
font-size: 15px;
font-weight: bold;
color: #ffffff;
}

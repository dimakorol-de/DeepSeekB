<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <text class="clock">{{ clock }}</text>
    <text class="title">Настройки</text>

    <scroll class="list" scroll-y="true">
      <div class="inner">
        <text class="section">API</text>

        <div class="card" onclick="openApiKey">
          <div class="card-main">
            <text class="card-label">API-ключ</text>
            <text class="card-value">{{ apiLabel }}</text>
          </div>
        </div>

        <div class="card" onclick="checkApi">
          <div class="card-main">
            <text class="card-label">Проверить API</text>
            <text class="card-value">Нажмите</text>
          </div>
        </div>

        <div class="card" onclick="cycleThinking">
          <div class="card-main">
            <text class="card-label">Думающий R1</text>
            <text class="card-value">{{ thinkingMode === 'on' ? 'Вкл' : 'Выкл' }}</text>
          </div>
        </div>

        <text class="section">Сеть</text>

        <div class="card" onclick="cycleNetwork">
          <div class="card-main">
            <text class="card-label">Режим сети</text>
            <text class="card-value">{{ netLabel }}</text>
          </div>
        </div>

        <div class="card" onclick="checkBridge">
          <div class="card-main">
            <text class="card-label">Мост FetchBridge</text>
            <text class="card-value">{{ bridgeStatus }}</text>
          </div>
        </div>

        <text class="section">Чаты</text>

        <div class="card" onclick="toggleAutoDelete">
          <div class="card-main">
            <text class="card-label">Автоудаление</text>
            <text class="card-value">{{ autoDelete ? '3 дня' : 'Выкл' }}</text>
          </div>
        </div>

        <div class="card" onclick="askClear">
          <div class="card-main">
            <text class="card-label">Очистить чаты</text>
            <text class="card-value">Удалить</text>
          </div>
        </div>

        <div class="item-pad"></div>
      </div>
    </scroll>

    <div if="{{ clearShow }}" class="mask">
      <div class="dialog">
        <div class="dialog-btn dialog-btn-cancel" onclick="cancelClear">
          <text class="dialog-sym">Отмена</text>
        </div>
        <text class="dialog-title">Удалить все диалоги?</text>
        <text class="dialog-sub">Вся история сообщений будет стёрта</text>
        <div class="dialog-btn dialog-btn-delete" onclick="confirmClear">
          <text class="dialog-sym dialog-sym-del">Удалить</text>
        </div>
      </div>
    </div>

    <div if="{{ diagShow }}" class="mask">
      <div class="diag-dialog">
        <scroll class="diag-scroll" scroll-y="true">
          <div class="diag-inner">
            <text class="diag-title">Проверка API</text>
            <text class="diag-text">{{ diagText }}</text>
          </div>
        </scroll>
        <div class="diag-btn" onclick="closeDiag">
          <text class="diag-btn-text">Закрыть</text>
        </div>
      </div>
    </div>

    <input-method
      if="{{ keyboardVisible }}"
      id="im"
      keyboard-type="{{ keyboardType }}"
      initial-text="{{ keyDraft }}"
      @input="onKeyInput"
      @delete="onKeyDelete"
      @enter="onKeyEnter"
      @hide="onKeyboardHide">
    </input-method>
  </div>
</template>

<script>
import {
  KEY_API_KEY,
  KEY_AUTO_DELETE,
  KEY_MODEL,
  KEY_NETWORK_MODE,
  KEY_THINKING_MODE,
  AUTO_DELETE_DAYS,
  getValue,
  setValue,
  removeValue,
  cleanupInactiveChats,
  clearAllChats
} from "../../common/app-store.js"
import { apiDiagnose, DEFAULT_MODEL, REASONER_MODEL } from "../../common/deepseek-api.js"
import { bridgeSupported, bridgeDiagnose, bridgePing, bridgeReady } from "../../common/bridge.js"

export default {
  private: {
    clock: "",
    apiKey: "",
    apiLabel: "Не задан",
    netLabel: "Авто",
    autoDelete: false,
    clearShow: false,
    diagShow: false,
    diagText: "",
    keyboardVisible: false,
    keyboardType: "QWERTY",
    keyDraft: "",
    timer: null,
    networkMode: "auto",
    bridgeStatus: "не проверен",
    thinkingMode: "off"
  },

  onInit() {
    this.tick()
    this.timer = setInterval(() => {
      this.tick()
    }, 20000)
    this.loadSettings()
  },

  onShow() {
    this.tick()
    this.loadSettings()
  },

  onDestroy() {
    if (this.timer) {
      clearInterval(this.timer)
      this.timer = null
    }
  },

  tick() {
    const now = new Date()
    const h = now.getHours()
    const m = now.getMinutes()
    this.clock = (h < 10 ? "0" + h : "" + h) + ":" + (m < 10 ? "0" + m : "" + m)
  },

  loadSettings() {
    getValue(KEY_API_KEY, "", (value) => {
      this.apiKey = value || ""
      this.updateLabels()
    })
    getValue(KEY_AUTO_DELETE, "off", (value) => {
      this.autoDelete = value === "on"
    })
    getValue(KEY_NETWORK_MODE, "auto", (value) => {
      this.networkMode = value || "auto"
      this.refreshBridge()
      this.updateLabels()
    })
    getValue(KEY_THINKING_MODE, "off", (value) => {
      this.thinkingMode = value || "off"
    })
  },

  updateLabels() {
    if (this.apiKey) {
      this.apiLabel = this.apiKey.length > 8 ? "…" + this.apiKey.slice(-4) : "Задан"
    } else {
      this.apiLabel = "Не задан"
    }
    const map = {
      auto: "Авто",
      bridge: "Через телефон",
      direct: "Напрямую",
      doh: "DNS через DoH",
      relay: "Свой прокси"
    }
    this.netLabel = map[this.networkMode] || "Авто"
  },  cycleThinking() {
    this.thinkingMode = this.thinkingMode === "on" ? "off" : "on"
    setValue(KEY_THINKING_MODE, this.thinkingMode)
    setValue(KEY_MODEL, this.thinkingMode === "on" ? REASONER_MODEL : DEFAULT_MODEL)
  },

  cycleNetwork() {
    const order = ["auto", "bridge", "direct", "doh", "relay"]
    let cur = order.indexOf(this.networkMode)
    if (cur < 0) cur = 0
    const nextIndex = (cur + 1) % order.length
    this.networkMode = order.slice(nextIndex, nextIndex + 1).pop()
    setValue(KEY_NETWORK_MODE, this.networkMode)
    this.refreshBridge()
    this.updateLabels()
  },

  checkApi() {
    if (!this.apiKey) {
      this.diagText = "Сначала задайте API-ключ в пункте выше"
      this.diagShow = true
      return
    }
    this.diagText = "Проверяю..."
    this.diagShow = true
    const self = this
    apiDiagnose({
      apiKey: this.apiKey,
      timeout: 15000
    })
      .then(function (res) {
        let text = res.ok ? (res.text || "Ключ работает") : (res.text || "Ошибка")
        text = text + "\n\nHTTP " + (res.status || "-")
        if (res.hint) {
          text = text + "\n\n" + res.hint
        }
        self.diagText = text
      })
      .catch(function (err) {
        self.diagText = "Ошибка: " + ((err && err.message) || "неизвестно")
      })
  },

  closeDiag() {
    this.diagShow = false
  },

  refreshBridge() {
    if (!bridgeSupported()) {
      this.bridgeStatus = "не поддерживается"
      return
    }
    let ready = false
    try {
      ready = bridgeReady()
    } catch (e) {}
    this.bridgeStatus = ready ? "готов к работе" : "не проверен"
  },

  checkBridge() {
    if (!bridgeSupported()) {
      this.bridgeStatus = "не поддерживается"
      return
    }
    this.bridgeStatus = "поиск..."
    try {
      bridgePing()
    } catch (e) {}
    const self = this
    setTimeout(function () {
      try {
        if (bridgeReady()) {
          self.bridgeStatus = "готов к работе"
          return
        }
      } catch (e) {}
      bridgeDiagnose(8000)
        .then(function (res) {
          if (res && (res.status === 0 || res.status === 200 || res.status === 201)) {
            self.bridgeStatus = "готов к работе"
          } else if (res && res.status === 1001) {
            self.bridgeStatus = "включите FetchBridge"
          } else {
            self.bridgeStatus = "нет соединения"
          }
        })
        .catch(function () {
          self.bridgeStatus = "ошибка"
        })
    }, 700)
  },

  openApiKey() {
    this.keyDraft = this.apiKey
    this.keyboardVisible = true
  },

  onKeyInput(e) {
    const val = e && e.detail ? e.detail.value : (e && e.value ? e.value : "")
    if (val) {
      this.keyDraft = this.keyDraft + val
    }
  },

  onKeyDelete() {
    if (this.keyDraft.length > 0) {
      this.keyDraft = this.keyDraft.substring(0, this.keyDraft.length - 1)
    }
  },

  onKeyboardHide() {
    this.keyboardVisible = false
    this.keyDraft = ""
  },

  onKeyEnter(e) {
    let raw = this.keyDraft
    if (e && e.detail && typeof e.detail.value === "string") {
      raw = e.detail.value
    } else if (e && typeof e.value === "string") {
      raw = e.value
    }
    const key = raw.trim()
    this.keyboardVisible = false
    this.keyDraft = ""

    if (!key) {
      removeValue(KEY_API_KEY, () => {
        this.apiKey = ""
        this.updateLabels()
      })
      return
    }

    setValue(KEY_API_KEY, key, (ok) => {
      if (ok) {
        this.apiKey = key
      }
      this.updateLabels()
    })
  },

  toggleAutoDelete() {
    const next = !this.autoDelete
    this.autoDelete = next
    setValue(KEY_AUTO_DELETE, next ? "on" : "off")
    if (next) {
      cleanupInactiveChats(function () {}, AUTO_DELETE_DAYS)
    }
  },

  askClear() {
    this.clearShow = true
  },

  cancelClear() {
    this.clearShow = false
  },

  confirmClear() {
    this.clearShow = false
    clearAllChats(() => {})
  }
}
</script>

<style>
.page {
  width: 192px;
  height: 490px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.clock {
  position: absolute;
  left: 0px;
  top: 26px;
  width: 192px;
  text-align: center;
  font-size: 17px;
  font-weight: bold;
  line-height: 24px;
  color: rgba(255, 255, 255, 0.78);
}

.title {
  position: absolute;
  left: 0px;
  top: 50px;
  width: 192px;
  text-align: center;
  font-size: 22px;
  font-weight: bold;
  line-height: 28px;
  color: #ffffff;
}

.list {
  position: absolute;
  left: 0px;
  top: 88px;
  width: 192px;
  height: 392px;
  flex-direction: column;
}

.inner {
  width: 192px;
  flex-direction: column;
  align-items: center;
}

.section {
  width: 168px;
  height: 28px;
  margin-top: 4px;
  padding-left: 8px;
  font-size: 13px;
  font-weight: bold;
  line-height: 28px;
  color: rgba(255, 255, 255, 0.45);
}

.card {
  width: 168px;
  height: 68px;
  margin-bottom: 10px;
  padding-left: 14px;
  padding-right: 12px;
  background-color: #262626;
  border-radius: 20px;
  flex-direction: row;
  align-items: center;
}

.card-main {
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.card-label {
  font-size: 15px;
  font-weight: bold;
  color: #ffffff;
}

.card-value {
  margin-top: 3px;
  font-size: 13px;
  font-weight: bold;
  color: #4d6bfe;
}

.item-pad {
  width: 192px;
  height: 30px;
}

.mask {
  position: absolute;
  left: 0px;
  top: 0px;
  width: 192px;
  height: 490px;
  background-color: rgba(0, 0, 0, 0.85);
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 168px;
  padding: 16px 12px;
  background-color: #262626;
  border-radius: 22px;
  flex-direction: column;
  align-items: center;
}

.dialog-title {
  margin-top: 10px;
  text-align: center;
  font-size: 17px;
  font-weight: bold;
  color: #ffffff;
}

.dialog-sub {
  margin-top: 6px;
  text-align: center;
  font-size: 13px;
  color: rgba(255, 255, 255, 0.6);
}

.dialog-btn {
  width: 116px;
  height: 40px;
  border-radius: 20px;
  border-width: 2px;
  border-style: solid;
  align-items: center;
  justify-content: center;
}

.dialog-btn-cancel {
  border-color: #4d6bfe;
}

.dialog-btn-delete {
  margin-top: 14px;
  border-color: #ff5050;
}

.dialog-sym {
  font-size: 14px;
  font-weight: bold;
  color: #ffffff;
}

.dialog-sym-del {
  color: #ff5050;
}

.diag-dialog {
  width: 176px;
  height: 310px;
  background-color: #262626;
  border-radius: 20px;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 14px 10px;
}

.diag-scroll {
  width: 156px;
  height: 220px;
  flex-direction: column;
}

.diag-inner {
  width: 156px;
  flex-direction: column;
  align-items: center;
}

.diag-title {
  width: 156px;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}

.diag-text {
  width: 156px;
  margin-top: 8px;
  font-size: 13px;
  line-height: 18px;
  color: #ffffff;
  word-break: break-all;
}

.diag-btn {
  width: 110px;
  height: 40px;
  margin-top: 8px;
  border-radius: 20px;
  border-width: 2px;
  border-style: solid;
  border-color: #4d6bfe;
  align-items: center;
  justify-content: center;
}

.diag-btn-text {
  font-size: 15px;
  font-weight: bold;
  color: #ffffff;
}
</style>


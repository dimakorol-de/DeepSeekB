  height: 324px;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.empty-image {
  width: 72px;
  height: 72px;
  margin-bottom: 8px;
}

.empty-title {
  width: 168px;
  text-align: center;
  font-size: 16px;
  font-weight: bold;
  line-height: 22px;
  color: rgba(255, 255, 255, 0.45);
  lines: 1;
  text-overflow: ellipsis;
}

.empty-sub {
  width: 168px;
  margin-top: 2px;
  text-align: center;
  font-size: 14px;
  line-height: 20px;
  color: rgba(255, 255, 255, 0.35);
  lines: 1;
  text-overflow: ellipsis;
}


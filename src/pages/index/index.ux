  position: absolute;
  left: 0px;
  top: 0px;
  width: 192px;
  height: 490px;
  background-color: rgba(0, 0, 0, 0.85);
  align-items: center;
  justify-content: center;
}

.dialog {
  width: 168px;
  padding: 16px 12px;
  background-color: #262626;
  border-radius: 22px;
  flex-direction: column;
  align-items: center;
}

.dialog-btn {
  width: 116px;

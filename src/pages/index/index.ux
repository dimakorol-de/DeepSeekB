  border-radius: 20px;
  background-color: rgba(255, 255, 255, 0.08);
  border-width: 2px;
  border-style: solid;
  align-items: center;
  justify-content: center;
}

.dialog-btn-cancel {
  border-color: #4d6bfe;
}

